# ========================================
# Image Search API - Production Configuration
# ========================================
# DO NOT commit this file with real secrets!
# Use environment variables in your deployment platform

# ===== Environment =====
ENVIRONMENT=production
DEBUG=false

# ===== API =====
API_TITLE=Image Search API
API_VERSION=2.0.0

# ===== Security - CHANGE THESE IN PRODUCTION! =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-100-character-secret-key-minimum-32-characters-for-security
API_KEY=your-api-key-for-service-auth
INDEXATION_API_KEY=your-indexation-api-key-for-django

# ===== CORS - Whitelist your frontend domain =====
# Format: http://domain.com or https://domain.com
CORS_ORIGINS=["https://your-frontend.com", "https://your-app.example.com"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["GET", "POST"]

# ===== Qdrant Vector Database =====
# For Azure Container Apps: use internal DNS or connection string
QDRANT_HOST=your-qdrant-service.azurecontainerapps.io
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key-change-this
QDRANT_COLLECTION_NAME=products
QDRANT_TIMEOUT=60.0
QDRANT_VERIFY_SSL=true

# ===== Redis Cache =====
# For Azure: use Azure Cache for Redis connection string
# Format: redis://:password@host:port/0
REDIS_HOST=your-redis-service.redis.cache.windows.net
REDIS_PORT=6379
REDIS_PASSWORD=your-strong-redis-password-here
REDIS_SSL=true

# ===== CLIP Model =====
MODEL_NAME=openai/clip-vit-base-patch32
EMBEDDING_DIM=512
TOP_K=10

# ===== Cache =====
CACHE_TTL=7200
CACHE_ENABLED=true

# ===== Upload Security =====
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp"]

# ===== URL Validation (SSRF Prevention) =====
# Only allow images from these domains (optional whitelist)
ALLOW_IMAGE_URLS=true
# IMAGE_URL_WHITELIST=["cdn.example.com", "images.example.com"]
MAX_IMAGE_URL_TIMEOUT=10

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_SEARCH=100
RATE_LIMIT_AUTH_SEARCH=1000
RATE_LIMIT_AUTH_UPLOAD=50
RATE_LIMIT_WINDOW=60

# ===== Logging =====
LOG_LEVEL=WARNING
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ===== Request Size =====
MAX_BODY_SIZE=52428800

# ===== JWT =====
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
