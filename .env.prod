# ========================================
# Image Search API - PRODUCTION Environment
# ========================================
# THIS FILE IS FOR PRODUCTION DEPLOYMENT
# DO NOT commit real secrets! Use platform secrets management
# (Azure Key Vault, GitHub Secrets, etc.)

# ===== Environment =====
ENVIRONMENT=production
DEBUG=false

# ===== API =====
API_TITLE=Image Search API
API_VERSION=2.0.0

# ===== CRITICAL SECURITY - MUST CHANGE BEFORE DEPLOYMENT =====
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use at least 32 characters for security
SECRET_KEY=your-production-secret-key-minimum-32-characters-CHANGE-THIS

# API Keys for service-to-service authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-production-api-key-CHANGE-THIS
INDEXATION_API_KEY=your-production-indexation-key-CHANGE-THIS

# ===== CORS Configuration =====
# Set to your actual frontend domains
# Example: ["https://app.yourdomain.com", "https://www.yourdomain.com"]
CORS_ORIGINS=["https://yourdomain.com"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["GET", "POST"]
CORS_ALLOW_HEADERS=["Content-Type", "Authorization"]

# ===== Qdrant Vector Database =====
# For production, use managed Qdrant or self-hosted with TLS
# Azure: Use Azure Container Apps or VM with TLS
QDRANT_HOST=qdrant-prod.yourdomain.com
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-production-key-CHANGE-THIS
QDRANT_COLLECTION_NAME=products
QDRANT_TIMEOUT=60.0
QDRANT_VERIFY_SSL=true

# ===== Redis Cache - PRODUCTION MANAGED SERVICE =====
# For Azure: Use Azure Cache for Redis
# Format: redis://:password@host:port/0
# With TLS: rediss://:password@host:port/0
REDIS_HOST=your-redis-prod.redis.cache.windows.net
REDIS_PORT=6379
REDIS_PASSWORD=your-strong-production-redis-password-CHANGE-THIS
REDIS_SSL=true

# ===== Machine Learning Model =====
MODEL_NAME=openai/clip-vit-base-patch32
EMBEDDING_DIM=512
TOP_K=10

# ===== Cache Configuration =====
CACHE_TTL=7200
CACHE_ENABLED=true

# ===== Security - File Upload =====
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp"]
IMAGE_MIME_TYPES=["image/jpeg", "image/png", "image/webp"]

# ===== Security - URL Validation (SSRF Prevention) =====
ALLOW_IMAGE_URLS=true
# Whitelist only trusted image CDNs
# Example: ["cdn.yourdomain.com", "images.yourdomain.com", "cloudinary.com"]
IMAGE_URL_WHITELIST=["cdn.yourdomain.com"]
MAX_IMAGE_URL_TIMEOUT=10

# ===== Rate Limiting (DDoS Protection) =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_SEARCH=100
RATE_LIMIT_AUTH_SEARCH=1000
RATE_LIMIT_AUTH_UPLOAD=50
RATE_LIMIT_WINDOW=60

# ===== Logging Configuration =====
# Production should use WARNING or ERROR only
LOG_LEVEL=WARNING
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ===== Request Security =====
MAX_BODY_SIZE=52428800

# ===== JWT Configuration =====
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# ===== Sentry/Error Tracking (Optional) =====
# For production error monitoring
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
